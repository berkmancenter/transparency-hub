# Environment Variables Configuration

# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control!

# ========================================
# MongoDB Configuration (Required)
# ========================================
# MongoDB connection string
# For local development: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/
NEXT_ATLAS_URI=mongodb://localhost:27017

# Database name to use
NEXT_ATLAS_DATABASE=transparency_hub

# ========================================
# Google Cloud Storage (Optional)
# ========================================
# Required only if you're running the WARC proxy feature
# Path to your Google Cloud service account credentials JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/credentials.json

# Google Cloud Storage bucket name where WARC files are stored
# GCS_BUCKET_NAME=your-bucket-name

# ========================================
# reCAPTCHA (Optional)
# ========================================
# If you're implementing reCAPTCHA for form protection
# Get your keys from: https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
# RECAPTCHA_SECRET_KEY=your-secret-key

# ========================================
# Development Settings
# ========================================
# Node environment (development, production, test)
NODE_ENV=development

# ========================================
# Vercel Analytics (Optional)
# ========================================
# Automatically configured when deployed to Vercel
# No manual configuration needed
